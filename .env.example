# Optional. Only needed if you do NOT run Ollama locally.
# Copy to .env and fill in ONE of the two options.

# Option A: Groq free tier (hosted)
# GROQ_API_KEY=

# Option B: any OpenAI-compatible local server (vLLM, llama.cpp, mlx_lm.server, ...)
# LOCAL_LLM_BASE_URL=http://localhost:8080/v1
# LOCAL_LLM_MODEL=
# LOCAL_LLM_API_KEY=
